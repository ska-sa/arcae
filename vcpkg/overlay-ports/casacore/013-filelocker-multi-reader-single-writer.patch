+FileLocker::FileLocker(FileLocker&& rhs)
+    : itsFD(std::exchange(rhs.itsFD, -1)),
+      itsStart(std::exchange(rhs.itsStart, 0)),
+      itsLength(std::exchange(rhs.itsLength, 0)),
+      itsMsgShown(rhs.itsMsgShown),
