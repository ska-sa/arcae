+Bool FileLocker::release() {
+    RecursiveMutexLock state_lock(itsState->mutex);
+    auto tid = std::this_thread::get_id();
+    auto it = itsState->lockType.find(tid);
+    if (it == std::end(itsState->lockType)) return True;
+
+    // Notify waiting threads of state change on exit
+    auto defer_notify = finally([&](...) { itsState->condVar.notify_all(); });
+
+    auto lock_type = it->second;
+    // Drop this thread's registration before counting, so that the count
+    // reflects the threads still holding the lock. The entry is erased rather
+    // than blanked so that the map stays bounded by the number of threads
+    // currently holding a lock.
+    itsState->lockType.erase(it);
+
+    // Other threads still share this lock, so leave the OS lock in place
+    if (numLocks(lock_type) > 0) return True;
+
+    // Wait until no one else is modifying the OS lock
+    itsState->condVar.wait(state_lock, [&]() { return !itsState->modifyingFcntlLock; });
+    itsState->modifyingFcntlLock = true;
+    auto result = fcntlRelease();
+    itsState->modifyingFcntlLock = false;
+    return result;
 }
 
