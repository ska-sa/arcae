+template <typename Fn>
+struct Finally {
+  Fn fn;
+  bool enabled = true;
+  ~Finally() {
+    if (enabled) fn();
+  };
+};
+
+template <typename Fn>
+auto finally(Fn&& fn) {
+  return Finally<Fn>{std::forward<Fn>(fn), true};
