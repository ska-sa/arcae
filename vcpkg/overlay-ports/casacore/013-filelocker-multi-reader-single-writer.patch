+  // The moved-from FileLocker must still be destructible/assignable; give it
+  // a fresh private state rather than leaving it null.
+  rhs.itsState = std::make_shared<LockState>();
+}
+
+FileLocker& FileLocker::operator=(FileLocker&& rhs) {
+  if (this != &rhs) {
+    std::swap(itsFD, rhs.itsFD);
+    std::swap(itsStart, rhs.itsStart);
+    std::swap(itsLength, rhs.itsLength);
+    std::swap(itsMsgShown, rhs.itsMsgShown);
+    std::swap(itsState, rhs.itsState);
+  }
+  return *this;
+}
 
