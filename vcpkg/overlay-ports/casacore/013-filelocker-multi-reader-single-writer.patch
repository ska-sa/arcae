+  RecursiveMutexLock state_lock(itsState->mutex);
+  // Notify waiting threads of state change on exit
+  auto defer_notify = finally([&](...) { itsState->condVar.notify_all(); });
+  auto AllLocks = [this]() -> std::size_t { return numLocks(Read) + numLocks(Write); };
+  auto tid = std::this_thread::get_id();
+  auto held = heldType();
+
+  // Already satisfied: this thread holds a lock at least as strong as the
+  // request (a write lock implies a read lock). Return without counting the
+  // nesting, and without a matching release becoming necessary.
+  //
+  // This idempotence is not an optimisation, it is required. PlainTable::lock
+  // re-acquires inside its "while (tableChanged)" loop after syncTable() has
+  // dropped the process's locks, and unlocks only once no matter how often it
+  // went round. A depth counter would leave the thread registered as a holder
+  // forever, and every later writer would wait on it.
+  if (held == Write || held == requested_lock_type) return True;
+
+  // held is None, or a Read being upgraded to a Write
+  const bool upgrade = (held == Read && requested_lock_type == Write);
+
+  if (upgrade) {
+    // Stop counting as a reader for the duration of the wait. Two readers
+    // upgrading at the same time would otherwise each wait for the other's
+    // read lock to go away, and neither can drop it while it is waiting.
+    // The fcntl lock itself stays in place; only the registration goes, and
+    // it is restored below if the upgrade does not happen.
+    itsState->lockType.erase(tid);
+    itsState->condVar.notify_all();
+  }
+
+  if (requested_lock_type == Write) {
+    // Signal that we want a write lock, so that readers queue behind us
+    itsState->wantsWriteLock += 1;
+    // Wait until no other thread is modifying the OS lock and no thread
+    // holds one
+    itsState->condVar.wait(state_lock,
+                           [&]() { return !itsState->modifyingFcntlLock && AllLocks() == 0; });
+  } else {
+    // Wait until no other thread is modifying the OS lock, no thread
+    // wants a write lock, and no thread holds one
+    itsState->condVar.wait(state_lock, [&]() {
+      return !itsState->modifyingFcntlLock && itsState->wantsWriteLock == 0 && numLocks(Write) == 0;
+    });
+    // Another thread already holds the OS read lock. Register this thread
+    // as a shared reader and return without touching fcntl.
+    if (numLocks(Read) > 0) {
+      itsState->lockType[tid] = Read;
       return True;
     }
