+// The lock type held by the calling thread, or None. Must be called with
+// itsState->mutex held.
+FileLocker::LockType FileLocker::heldType() const {
+  auto it = itsState->lockType.find(std::this_thread::get_id());
+  return it == std::end(itsState->lockType) ? None : it->second;
+}
